POSTGRES_DB=mtm_sms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Production may set one PostgreSQL/Supabase connection URL instead of the
# individual POSTGRES_* values above.
DATABASE_URL=
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=true
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=false
JWT_BLACKLIST_AFTER_ROTATION=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=WARNING
MTM_APP_VERSION=5.8
MTM_N8N_INTEGRATION_SECRET=replace-with-a-random-server-to-server-secret
MTM_OUTBOX_CLAIM_TIMEOUT_SECONDS=900
MTM_OUTBOX_MAX_ATTEMPTS=5
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
MTM_MEDIA_STORAGE=local
SUPABASE_STORAGE_BUCKET=your-private-media-bucket
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-project-region
SUPABASE_S3_ACCESS_KEY_ID=your-server-side-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=your-server-side-secret-key
