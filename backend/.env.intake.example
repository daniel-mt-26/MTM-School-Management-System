# Disabled by default. Never copy a guessed tenant ID or unapproved privacy policy.
MTM_INTAKE_ENABLED=false
MTM_INTAKE_BEAVERS_SCHOOL_ID=0
MTM_INTAKE_PRIVACY_APPROVED=false
MTM_INTAKE_PRIVACY_VERSION=
# Pending/approved applications and unresolved enquiries have no automatic expiry.
# Rejected applications/resolved enquiries expire one calendar month after transition.
# Policy is fixed in code; legacy application/enquiry RETENTION_DAYS are ignored.
# Approved records await a verified transfer and recordkeeping workflow.
# retention_hold blocks deletion for preservation requirements (internal use).
# Technical replay keys use the independent day-based setting below.
MTM_INTAKE_KEY_RETENTION_DAYS=0
MTM_INTAKE_ALLOWED_ORIGINS=
# Production requires Turnstile. Its widget action must be beavers_intake.
MTM_INTAKE_CHALLENGE_REQUIRED=true
MTM_INTAKE_CHALLENGE_SECRET=
MTM_INTAKE_TRUSTED_PROXY_CIDRS=
MTM_INTAKE_MAX_BYTES=16384
MTM_INTAKE_IP_LIMIT=20
MTM_INTAKE_SCHOOL_LIMIT=200
MTM_INTAKE_RECIPIENT_LIMIT=3
MTM_INTAKE_EMAIL_ENABLED=false
MTM_INTAKE_SMTP_VERIFIED=false
MTM_INTAKE_EMAIL_MAX_ATTEMPTS=5
MTM_INTAKE_EMAIL_LEASE_SECONDS=600
# Server-only SMTP and public email content configuration. No credentials supplied.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS: true/false on 587; implicit TLS: false/true on 465. Never enable both.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
MTM_INTAKE_SCHOOL_EMAIL=beaversecdcentre@gmail.com
# Approved HTTPS frontend origin only, not /login or the backend /api URL.
MTM_INTAKE_DASHBOARD_URL=
MTM_INTAKE_CONTACT_EMAIL=beaversecdcentre@gmail.com
MTM_INTAKE_CONTACT_PHONES=+263 775 177 935 / +263 772 405 912
# Set EMAIL_ENABLED/SMTP_VERIFIED true only after provider/sender approval and an approved delivery smoke test.
